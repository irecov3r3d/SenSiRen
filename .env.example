# Gemini API key — required for AI responses and neural TTS.
# Must use NEXT_PUBLIC_ prefix because the app is a static client-side export
# and makes API calls from the browser.
# Get a key at: https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: base URL of the app (used in some AI Studio deployments)
APP_URL="http://localhost:3000"
